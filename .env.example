# Database — Postgres (Neon/Supabase). The Prisma schema provider is "postgresql",
# so a sqlite `file:./dev.db` value will fail with P1012.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin panel password — set a strong value in Vercel for production.
ADMIN_TOKEN="admin123"

# Image storage (logo, gallery, hero). Required on Vercel because its filesystem is
# read-only. Create it at Vercel → Storage → Create → Blob, then copy the token here
# and into Vercel → Settings → Environment Variables. Without it, uploads fall back to
# public/uploads, which only works in local development.
BLOB_READ_WRITE_TOKEN=""
